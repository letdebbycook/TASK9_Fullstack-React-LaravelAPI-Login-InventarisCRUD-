              "raw": "{\n  \"category_id\": 1,\n  \"name\": \"Router WiFi TP-Link Archer C6\",\n  \"sku\": \"NET-RTR-001\",\n  \"stock\": 12,\n  \"price\": 425000\n}"
            },
