{
  "info": {
    "name": "Inventaris API (Fullstack Task 9 - ID Restricted & Custom Messages)",
    "description": "Koleksi Postman untuk pengujian API Inventaris Laravel Sanctum dengan proteksi ID Restriction dan Custom Notification Messages.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api", "type": "string" },
    { "key": "token_user1", "value": "", "type": "string" },
    { "key": "token_user2", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Autentikasi & Register (Notifikasi / Pesan Kustom)",
      "item": [
        {
          "name": "1.1 Login User 1 (Admin Test) -> Auto-save token_user1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token_user1', res.data.token);",
                  "    console.log('token_user1 tersimpan:', res.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Login User 2 (Restricted Test User) -> Auto-save token_user2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user2@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token_user2', res.data.token);",
                  "    console.log('token_user2 tersimpan:', res.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Register - Email Duplikat (Custom Message: Email sudah terdaftar)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplikat\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "1.4 Register - Akun Baru Berhasil (Custom Welcome Message)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Siswa Magang\",\n  \"email\": \"user_baru@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "1.5 Get Profile User 1 (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user1}}" }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": ["{{base_url}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "1.6 Logout User 1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user1}}" }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Pengujian ID Restriction (Akses Terbatas Antar User)",
      "item": [
        {
          "name": "2.1 User 1 - Lihat Kategori Sendiri (Muncul 3 Kategori)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user1}}" }
            ],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "2.2 User 2 - Lihat Kategori Sendiri (Hanya Muncul 1 Kategori)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user2}}" }
            ],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "2.3 User 1 - Lihat Barang Sendiri (Muncul 7 Barang)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user1}}" }
            ],
            "url": {
              "raw": "{{base_url}}/items",
              "host": ["{{base_url}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "2.4 User 2 - Lihat Barang Sendiri (Hanya Muncul 1 Barang)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user2}}" }
            ],
            "url": {
              "raw": "{{base_url}}/items",
              "host": ["{{base_url}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "2.5 [RESTRICTED TEST] User 2 Akses Detail Kategori 1 (Milik User 1) -> 404 Blocked",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user2}}" }
            ],
            "url": {
              "raw": "{{base_url}}/categories/1",
              "host": ["{{base_url}}"],
              "path": ["categories", "1"]
            }
          }
        },
        {
          "name": "2.6 [RESTRICTED TEST] User 2 Akses Detail Barang 1 (Milik User 1) -> 404 Blocked",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user2}}" }
            ],
            "url": {
              "raw": "{{base_url}}/items/1",
              "host": ["{{base_url}}"],
              "path": ["items", "1"]
            }
          }
        },
        {
          "name": "2.7 [RESTRICTED TEST] User 2 Coba Update Barang 1 (Milik User 1) -> 403 Forbidden",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user2}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"name\": \"Laptop Dibajak User 2\",\n  \"sku\": \"ELK-LPT-001\",\n  \"stock\": 99,\n  \"price\": 1000\n}"
            },
            "url": {
              "raw": "{{base_url}}/items/1",
              "host": ["{{base_url}}"],
              "path": ["items", "1"]
            }
          }
        },
        {
          "name": "2.8 [RESTRICTED TEST] User 2 Coba Hapus Barang 1 (Milik User 1) -> 403 Forbidden",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user2}}" }
            ],
            "url": {
              "raw": "{{base_url}}/items/1",
              "host": ["{{base_url}}"],
              "path": ["items", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Operasi CRUD Inventaris & Pesan Sukses (User 1)",
      "item": [
        {
          "name": "3.1 Tambah Kategori Baru",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_user1}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Peralatan Jaringan\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "3.2 Tambah Barang Baru",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
